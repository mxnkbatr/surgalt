# MongoDB Atlas → Database → Connect → Drivers → холбоосын мөрийг хуулна
# Жишээ: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dcapital?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dcapital?retryWrites=true&w=majority

# JWT нууц түлхүүр (production-д өөрчлөнө)
JWT_SECRET=dcapital-change-this-secret

PORT=4000

# Админ (анхны seed)
ADMIN_PHONE=99833347
ADMIN_PASSWORD=admin123
